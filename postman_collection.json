  "item": [
    {
      "name": "1. Health & Telemetry",
      "item": [
        {
          "name": "GET /health - Service & Database Health",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 200', () => pm.response.to.have.status(200));",
                  "const json = pm.response.json();",
                  "pm.test('Service is healthy', () => {",
                  "    pm.expect(json.status).to.eql('healthy');",
                  "    pm.expect(json.database.status).to.eql('connected');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/health",
              "host": ["{{baseUrl}}"],
              "path": ["health"]
            },
            "description": "Verifies that the API server is alive and connected to SQLite database."
          }
        },
        {
          "name": "GET /metrics - Volume & Error Telemetry",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 200', () => pm.response.to.have.status(200));",
                  "const json = pm.response.json();",
                  "pm.test('Metrics object contains counters', () => {",
                  "    pm.expect(json.success).to.be.true;",
                  "    pm.expect(json.data).to.have.property('messagesCreated');",
                  "    pm.expect(json.data).to.have.property('webhooksTotal');",
                  "    pm.expect(json.data).to.have.property('workerQueue');",
                  "});"
                ],
