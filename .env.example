# Application Server Configuration
PORT=3000
NODE_ENV=development

# Persistent Database File Path (SQLite)
DATABASE_PATH=./data/messaging.db

# Logging Configuration (fatal | error | warn | info | debug | trace)
LOG_LEVEL=info

# Background Worker & Asynchronous Processing Queue
WORKER_ENABLED=true
WORKER_CONCURRENCY=2
WORKER_POLL_INTERVAL_MS=500
WORKER_MAX_RETRIES=3
WORKER_BACKOFF_BASE_MS=1000

# Security and Rate Limiting (optional placeholders)
API_SECRET_KEY=replace_with_secure_random_key_in_production
