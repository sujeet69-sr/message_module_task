# Application Server Configuration
PORT=3000
NODE_ENV=development

# PostgreSQL Connection Configuration
# Option A: Connection URL (Recommended)
DATABASE_URL=postgresql://postgres:your_password@localhost:5432/messaging_db

# Option B: Individual PostgreSQL Connection Parameters
PGHOST=localhost
PGPORT=5432
PGUSER=postgres
PGPASSWORD=your_password
PGDATABASE=messaging_db

# Logging Configuration (fatal | error | warn | info | debug | trace)
LOG_LEVEL=info

# Background Worker & Asynchronous Processing Queue
WORKER_ENABLED=true
WORKER_CONCURRENCY=2
WORKER_POLL_INTERVAL_MS=500
WORKER_MAX_RETRIES=3
WORKER_BACKOFF_BASE_MS=1000

# Security (optional placeholder)
API_SECRET_KEY=replace_with_secure_random_key_in_production
